# Copy to .env.local. With no keys the app runs in replay mode
# from recorded responses in fixtures/.

# OpenAI, used for reading shift notes, the tip policy and staff questions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# PayPal sandbox app from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: sandbox personal accounts that receive every test payout, so they can be claimed
PAYPAL_SANDBOX_RECEIVER=
PAYPAL_SANDBOX_VENMO_RECEIVER=

DATABASE_PATH=data/sidework.db

# auto: each service runs live once its keys are set, from fixtures/ otherwise
# record: live, and save every response to fixtures/ (tokens are blanked)
# off: always live
REPLAY=auto
FIXTURES_DIR=fixtures
