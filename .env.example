# Copy to .env.local. With no keys the app runs in replay mode
# from recorded responses in fixtures/.

# OpenAI, used for reading shift notes, the tip policy and staff questions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# PayPal sandbox app from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

DATABASE_PATH=data/sidework.db

# auto: live when all keys are set, replay otherwise
# record: live, and save every response to fixtures/
# off: always live
REPLAY=auto
